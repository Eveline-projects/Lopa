# .env.example - Environment configuration template
# Copy this file to a file named .env and fill in your own data.

# Django secret key (generate a new one, e.g., using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=replace-this-with-your-secret-key

# Debug mode (True for development, False for production)
DEBUG=True

# List of allowed hosts separated by commas (e.g., 127.0.0.1,localhost)
ALLOWED_HOSTS=127.0.0.1,localhost
